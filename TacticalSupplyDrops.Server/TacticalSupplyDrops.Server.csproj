<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\SPT</SptRoot>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Version>3.1.0</Version>
		<AssemblyVersion>3.1.0.0</AssemblyVersion>
		<FileVersion>3.1.0.0</FileVersion>
		<Product>Tactical Supply Drops</Product>
		<Company>nomadtribals</Company>
		<Description>Private air logistics and tactical supply delivery for SPT.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="4.1.6" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
	</ItemGroup>

	<Target Name="DeployTacticalSupplyDrops" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">

		<Copy SourceFiles="$(TargetPath)" DestinationFiles="$(SptRoot)\SPT_Runtime\user\mods\TacticalSupplyDrops\TacticalSupplyDrops.Server.dll" OverwriteReadOnlyFiles="true" />

		<Message Importance="high" Text="[TSD] Server DLL automatically deployed to SPT_Runtime." />

	</Target>
    <Target Name="DeployTsdBundleManifest" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\bundles.json" DestinationFiles="$(SptRoot)\SPT_Runtime\user\mods\TacticalSupplyDrops\bundles.json" OverwriteReadOnlyFiles="true" />
        <Message Importance="high" Text="[TSD] AssetBundle manifest deployed to SPT_Runtime." />
    </Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="if /I &quot;$(Configuration)&quot;==&quot;Debug&quot; (&#xA;    robocopy &quot;$(TargetDir).&quot; &quot;$(SptRoot)\SPT_Runtime\user\mods\TacticalSupplyDrops&quot; &quot;$(TargetFileName)&quot; /COPY:DAT /IS /IT /R:2 /W:1&#xA;    if errorlevel 8 exit /b 1&#xA;    exit /b 0&#xA;)" />
	</Target>

</Project>
