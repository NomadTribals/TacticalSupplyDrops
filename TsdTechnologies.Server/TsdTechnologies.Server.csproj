<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\SPT</SptRoot>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Product>TSD Technologies</Product>
		<Company>nomadtribals</Company>
		<Description>TSD Technologies physical field terminal and trader offer.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="4.1.6" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
	</ItemGroup>

</Project>
